@{
    ViewData["Title"] = "Giới thiệu công ty";
    ViewData["BodyClass"] = "page-company-vi";
}

@section PageCss {
    <link rel="stylesheet" href="/css/page.css">
    <link rel="stylesheet" href="/css/pages/page-company-vi.css">
}

<header class="page-header inview">
    <div class="page-header__sub" lang="en">about us</div>
    <h1 class="page-header__main">Về MICROTECHNO</h1>
</header>

<div class="widthBase">
    <div class="breadcrumb" itemprop="breadcrumb">
        <a href="/" class="home">HOME（MICROTECHNO VIETNAM CO., LTD）</a> &gt;
        <span class="post post-page current-item">Giới thiệu công ty</span>
    </div>
</div>

<div class="image-slider">
    <div class="image-slider__track">
        <ul class="image-slider__group">
            <li class="image-slider__item"><img src="/uploads/2026/04/img_line_01.jpg" alt="" loading="lazy"></li>
            <li class="image-slider__item"><img src="/uploads/2026/04/img_line_02.jpg" alt="" loading="lazy"></li>
            <li class="image-slider__item"><img src="/uploads/2026/04/img_line_03-1.jpg" alt="" loading="lazy"></li>
            <li class="image-slider__item"><img src="/uploads/2026/05/company.jpg" alt="" loading="lazy"></li>
        </ul>
        <ul class="image-slider__group" aria-hidden="true">
            <li class="image-slider__item"><img src="/uploads/2026/04/img_line_01.jpg" alt="" loading="lazy"></li>
            <li class="image-slider__item"><img src="/uploads/2026/04/img_line_02.jpg" alt="" loading="lazy"></li>
            <li class="image-slider__item"><img src="/uploads/2026/04/img_line_03-1.jpg" alt="" loading="lazy"></li>
            <li class="image-slider__item"><img src="/uploads/2026/05/company.jpg" alt="" loading="lazy"></li>
        </ul>
    </div>
</div>

<div class="widthBase">
    <div class="section">
        <section id="philosophy">
            <h2>Triết lý doanh nghiệp</h2>
            <p class="catch-phrase">Lấy sự tôn trọng con người làm nền tảng,<br>Đóng góp cho xã hội bằng chất lượng cao<br>thông qua sự tham gia đầy đủ và sáng tạo</p>
        </section>

        <section id="message">
            <h2>Thông điệp của Người đại diện</h2>
            <div class="message-txt">
                <div class="half">
                    <div class="half__item">
                        <p>Công ty TNHH Microtechno Việt Nam (sau đây gọi tắt là MVC) là cơ sở sản xuất ở nước ngoài của Công ty Microtechno Nhật Bản (MTC), đồng thời là một thành viên của Tập đoàn Toyo Advanced Technologies. Chúng tôi đảm nhận vai trò sản xuất linh kiện ô tô tại Việt Nam. MVC kế thừa vững chắc công nghệ gia công chính xác cùng tinh thần chú trọng chất lượng mà công ty mẹ MTC đã dày công xây dựng trong suốt nhiều năm qua. Với phương châm ưu tiên hàng đầu là "An toàn – Chất lượng – Tiến độ giao hàng", chúng tôi luôn nỗ lực thực hiện hoạt động sản xuất nhằm mang đến sự tin cậy cho khách hàng.</p>
                        <p>Trong bối cảnh ngành công nghiệp ô tô đang có nhiều thay đổi mạnh mẽ, chúng tôi tin rằng việc duy trì và cung cấp chất lượng ổn định chính là sứ mệnh quan trọng nhất của mình. Bên cạnh đó, MVC không chỉ đơn thuần là một cơ sở sản xuất, mà còn là doanh nghiệp gắn bó và phát triển cùng Việt Nam. Chúng tôi đặc biệt chú trọng đến việc đào tạo nguồn nhân lực và cải thiện môi trường làm việc.</p>
                    </div>
                    <div class="half__item">
                        <img class="building-img" src="/uploads/2026/05/company.jpg" alt="Công ty TNHH Microtechno Việt Nam" loading="lazy">
                        <p>Chúng tôi tin rằng việc tạo dựng một môi trường nơi mỗi nhân viên địa phương có thể nâng cao kỹ năng, cảm nhận được sự trưởng thành của bản thân trong công việc sẽ góp phần nâng cao sức mạnh tập thể của tổ chức và hướng đến sự phát triển bền vững của doanh nghiệp.</p>
                        <p>MVC luôn chia sẻ và thực hiện những giá trị cốt lõi mà Tập đoàn Toyo Advanced Technologies đã gìn giữ, bao gồm: "Chân thành – Thử thách – Cải tiến liên tục". Đồng thời, chúng tôi cũng không ngừng thúc đẩy các hoạt động cải tiến dựa trên tinh thần coi trọng thực tế tại hiện trường, nhằm đáp ứng kỳ vọng của khách hàng trên toàn cầu. Trong thời gian tới, thông qua hoạt động sản xuất lấy chất lượng và sự tin cậy làm nền tảng, chúng tôi sẽ tiếp tục phấn đấu để trở thành doanh nghiệp được khách hàng, đối tác và cộng đồng địa phương tin tưởng và cần đến. Toàn thể cán bộ nhân viên MVC sẽ đồng lòng tiếp tục chinh phục những thử thách mới.</p>
                        <p class="signature">Công ty TNHH Microtechno Việt Nam<br>Tổng giám đốc　Ông Nakata Hiroshi</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="history">
            <h2>Lịch sử phát triển Microtechno Việt Nam</h2>
            <dl class="history">
                <div class="history__item">
                    <dt class="history__year">2014</dt>
                    <dd>
                        <p class="history__month">Tháng 7</p>
                        <p class="history__txt">Thành lập nhà máy</p>
                    </dd>
                </div>
                <div class="history__item">
                    <dt class="history__year">2016</dt>
                    <dd>
                        <p class="history__month">Tháng 12</p>
                        <p class="history__txt">Đạt chứng nhận <strong>ISO 9001:2015</strong></p>
                    </dd>
                </div>
                <div class="history__item">
                    <dt class="history__year">2018</dt>
                    <dd>
                        <p class="history__month">Tháng 3</p>
                        <p class="history__txt">Đạt chứng nhận <strong>ISO 14001:2015</strong></p>
                    </dd>
                </div>
                <div class="history__item">
                    <dt class="history__year">2019</dt>
                    <dd>
                        <p class="history__month">Tháng 8</p>
                        <p class="history__txt">Mở rộng nhà máy: <strong>3,200 → 7,890 m<sup>2</sup></strong></p>
                    </dd>
                </div>
                <div class="history__item">
                    <dt class="history__year">2020</dt>
                    <dd>
                        <p class="history__month">Tháng 5</p>
                        <p class="history__txt">Bắt đầu xuất khẩu sang <strong>Nhật Bản</strong></p>
                    </dd>
                    <dd>
                        <p class="history__month">Tháng 6</p>
                        <p class="history__txt">Bắt đầu xuất khẩu sang <strong>Mexico</strong></p>
                    </dd>
                    <dd>
                        <p class="history__month">Tháng 10</p>
                        <p class="history__txt">Bắt đầu xuất khẩu sang <strong>Trung Quốc</strong></p>
                    </dd>
                </div>
                <div class="history__item">
                    <dt class="history__year">2022</dt>
                    <dd>
                        <p class="history__txt">Bắt đầu triển khai sản xuất <strong>G4</strong></p>
                    </dd>
                </div>
            </dl>
        </section>

        <section id="certifications">
            <h2>Chứng nhận</h2>
            <ul class="policy-logo">
                <li class="policy-logo__item">
                    <div class="policy-logo__img"><img src="/uploads/2026/04/img_iso.jpg" alt="ISO 9001:2015" loading="lazy"></div>
                    <p class="policy-logo__txt">ISO 9001:2015</p>
                </li>
                <li class="policy-logo__item">
                    <div class="policy-logo__img"><img src="/uploads/2026/04/img_iso.jpg" alt="ISO 14001:2015" loading="lazy"></div>
                    <p class="policy-logo__txt">ISO 14001:2015</p>
                </li>
            </ul>
        </section>

        <section>
            <h2>Hồ sơ công ty</h2>
            <table class="sp_set">
                <tr><th>Tên công ty</th><td>MICROTECHNO Co., Ltd.</td></tr>
                <tr><th>Thành lập</th><td>22 tháng 6 năm 1971</td></tr>
                <tr><th>Vốn điều lệ</th><td>200 triệu yên</td></tr>
                <tr><th>Chủ tịch</th><td>Kenji Ikemoto</td></tr>
                <tr><th>Số nhân viên</th><td>184</td></tr>
                <tr><th>Lĩnh vực kinh doanh</th><td>Sản xuất con dấu đỉnh, linh kiện điều khiển thủy lực AT/CVT, linh kiện đường ống nhiên liệu</td></tr>
                <tr><th>Địa chỉ</th><td>676 Go, Takaya-cho, Thành phố Higashihiroshima, Hiroshima 739-2124, Nhật Bản</td></tr>
            </table>
        </section>
    </div>
</div>

<div class="mt-lg"></div>
@await Html.PartialAsync("_ConversionSection")
