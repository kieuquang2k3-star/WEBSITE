        vBusiness       = "Automotive parts manufacturing (Spool &amp; Sleeve for AT automatic transmissions &amp; engines)";
        vLocation       = "Plot J3,4 (RF-12), Thang Long Industrial Park II, Duong Hao Ward, Hung Yen Province, Vietnam";
        vArea           = "7,890 m²";
        vParent         = "Microtechno Japan Co., Ltd. (MTC) – Member of Toyo Advanced Technologies Group";
        mapAddress      = "Plot J3,4 (RF-12), Thang Long Industrial Park II, Duong Hao Ward, Hung Yen Province, Vietnam";
        mapAccess       = "TEL <a href=\"tel:02213974544\">022-1397-4544</a>";
    }
    else if (lang == "ja")
    {
        ViewData["Title"] = "会社概要";
        title = "会社概要"; sub = "company";
        sectionTitle = "会社概要";
        accessTitle  = "アクセス";
        fName           = "会社名";
        fEstablished    = "設立";
        fCapital        = "資本金";
        fRepresentative = "代表者";
        fEmployees      = "従業員数";
        fBusiness       = "事業内容";
        fLocation       = "所在地";
        fArea           = "工場面積";
        fParent         = "親会社";
        vName           = "マイクロテクノベトナム有限会社 (MVC)";
        vEstablished    = "2014年7月";
        vCapital        = "440万米ドル";
        vRepresentative = "中田博史";
        vEmployees      = "240名（日本人管理者3名）";
        vBusiness       = "自動車部品製造（AT自動変速機・エンジン用スプール＆スリーブ）";
        vLocation       = "Plot J3,4 (RF-12), Thang Long Industrial Park II, Duong Hao Ward, Hung Yen Province, Vietnam";
        vArea           = "7,890 m²";
        vParent         = "マイクロテクノ株式会社 (MTC) – 東洋先端技術グループ";
        mapAddress      = "Plot J3,4 (RF-12), Thang Long Industrial Park II, Duong Hao Ward, Hung Yen Province, Vietnam";
        mapAccess       = "TEL <a href=\"tel:02213974544\">022-1397-4544</a>";
    }
    else
    {
        ViewData["Title"] = "Giới thiệu công ty";
        title = "Giới thiệu công ty"; sub = "company";
        sectionTitle = "Hồ sơ công ty";
        accessTitle  = "Vị trí";
        fName           = "Tên công ty";
        fEstablished    = "Ngày thành lập";
        fCapital        = "Vốn điều lệ";
        fRepresentative = "Người đại diện";
        fEmployees      = "Số lượng nhân viên";
        fBusiness       = "Nội dung kinh doanh";
        fLocation       = "Vị trí";
        fArea           = "Diện tích nhà máy";
        fParent         = "Công ty mẹ";
        vName           = "Công ty TNHH Microtechno Việt Nam (MVC)";
        vEstablished    = "Tháng 7 năm 2014";
        vCapital        = "4,4 triệu USD";
        vRepresentative = "Ông Nakata Hiroshi – Tổng Giám đốc";
        vEmployees      = "240 người (3 quản lý người Nhật)";
        vBusiness       = "Sản xuất linh kiện ô tô (Spool &amp; Sleeve cho hộp số tự động AT &amp; động cơ)";
        vLocation       = "Lô J3,4 (RF-12), Khu công nghiệp Thăng Long II, Phường Dương Hào, Tỉnh Hưng Yên, Việt Nam";
