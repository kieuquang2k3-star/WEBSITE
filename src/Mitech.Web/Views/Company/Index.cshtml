@section PageCss {
    <link rel="stylesheet" href="/css/page.css">
    <link rel="stylesheet" href="/css/pages/page-company.css">
}

<header class="page-header inview">
    <div class="page-header__sub" lang="en">@sub</div>
    <h1 class="page-header__main">@title</h1>
</header>

<div class="widthBase">
    <div class="breadcrumb" itemprop="breadcrumb">
        <a href="/" class="home">@breadcrumbHome</a> &gt;
        <span class="post post-page current-item">@title</span>
    </div>
</div>

<div class="widthBase">
    <div class="section">
        <h2>@sectionTitle</h2>
        <table class="sp_set">
            <tr><th>@fName</th><td>@vName</td></tr>
            <tr><th>@fEstablished</th><td>@vEstablished</td></tr>
            <tr><th>@fCapital</th><td>@vCapital</td></tr>
            <tr><th>@fRepresentative</th><td>@vRepresentative</td></tr>
            <tr><th>@fEmployees</th><td>@vEmployees</td></tr>
            <tr><th>@fBusiness</th><td>@Html.Raw(vBusiness)</td></tr>
            <tr><th>@fLocation</th><td><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right:4px;vertical-align:middle;flex-shrink:0;"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/></svg>@vLocation</td></tr>
            <tr><th>@fArea</th><td>@vArea</td></tr>
            <tr><th>@fParent</th><td>@vParent</td></tr>
        </table>

        <h2>@accessTitle</h2>
        <div class="access-map" style="display:flex;gap:24px;align-items:flex-start;">
            <div class="access-map__img" style="flex:0 0 50%;max-width:50%;">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3727.1350229056616!2d106.08090469999999!3d20.906886699999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135a3002ebcd73d%3A0x58a8a511c77a5035!2sC%C3%94NG%20TY%20TNHH%20MICROTECHNO%20VI%E1%BB%86T%20NAM!5e0!3m2!1svi!2s!4v1780633781883!5m2!1svi!2s"
                        width="100%" height="450" style="border:0;display:block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
            <div class="access-map__info" style="flex:0 0 50%;max-width:50%;">
                <img src="/images/logo.png" alt="MICROTECHNO VIETNAM" style="max-width:220px;height:auto;display:block;margin-bottom:12px;">
                <img src="/images/mitech-banner.jpg" alt="MICROTECHNO VIETNAM CO.,LTD" style="max-width:70%;height:auto;display:block;margin-bottom:12px;">
                <p>@mapAddress<br>@Html.Raw(mapAccess)</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-lg"></div>
@await Html.PartialAsync("_ConversionSection")
