@section PageCss {
    <link rel="stylesheet" href="/css/page.css">
    <style>
        .recruit-hero {
            background: #1a2a5e;
            color: #fff;
            border-radius: 8px;
            padding: 28px 32px;
            margin: 24px 0 28px;
            text-align: center;
        }
        .recruit-hero__sub { font-size:.85rem; opacity:.75; margin-bottom:10px; }
        .recruit-hero__title { font-size:1.7rem; font-weight:900; letter-spacing:.03em; margin:0 0 10px; color:#ffd040; }
        @@media(max-width:600px){ .recruit-hero__title { font-size:1.25rem; } }
        .recruit-hero__desc { font-size:1rem; opacity:.9; margin-bottom:12px; }
        .recruit-hero__income { font-size:1.15rem; margin-bottom:14px; }
        .recruit-hero__income strong { color:#ffd040; font-size:1.3rem; }
        .recruit-hero__contact { font-size:.88rem; opacity:.85; border-top:1px solid rgba(255,255,255,.2); padding-top:12px; margin-top:4px; }
        .recruit-hero__contact strong { color:#fff; }
        .recruit-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin:32px 0; }
        @@media(max-width:640px){ .recruit-stats { grid-template-columns:1fr; } }
        .recruit-stat { background:#f5f7fb; border:1px solid #e4e9f2; border-radius:6px; padding:20px 22px; }
        .recruit-stat__label { font-size:.75rem; color:#888; margin-bottom:6px; }
        .recruit-stat__value { font-size:1.45rem; font-weight:800; color:#1a2a5e; }
        .recruit-section { border-top:1px solid #e8e8e8; padding:28px 0 4px; }
        .recruit-section h2 { font-size:1.05rem; font-weight:800; color:#1a2a5e; margin:0 0 16px; }
        /* ===== JOB GRID ===== */
        .job-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
        @@media(max-width:700px){ .job-grid { grid-template-columns:repeat(2,1fr); } }
        @@media(max-width:480px){ .job-grid { grid-template-columns:1fr; } }
        .job-card { display:block; border:1.5px solid #c8d3ef; border-radius:8px; padding:18px 20px;
                    text-decoration:none; color:inherit; height:100%; transition:border-color .2s; }
        .job-card:hover { border-color:#1a2a5e; text-decoration:none; }
        .job-card__title { font-weight:800; color:#1a2a5e; margin-bottom:8px; font-size:.95rem; }
        .job-card__desc { font-size:.85rem; color:#555; line-height:1.65; margin-bottom:12px; }
        .job-card__cta { font-size:.82rem; color:#00418f; font-weight:600; }
        .schedule-note { font-size:.82rem; color:#777; margin-bottom:18px; }
        .schedule-blocks { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
        @@media(max-width:520px){ .schedule-blocks { grid-template-columns:1fr; } }
        .schedule-block {
            border-radius:8px; padding:16px 18px;
            border-left:4px solid transparent;
        }
        .schedule-block--admin { background:#e8f5e9; border-color:#43a047; grid-column:1/-1; }
        .schedule-block--day   { background:#eef4ff; border-color:#3b82f6; }
        .schedule-block--night { background:#f0eeff; border-color:#8b5cf6; }
        .schedule-block--prod  { background:#ecfdf5; border-color:#10b981; grid-column:1/-1; }
        .schedule-block--fixed { background:#fff7ed; border-color:#f59e0b; grid-column:1/-1; }
        .schedule-block__label { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#888; margin-bottom:6px; }
        .schedule-block__time  { font-size:1.2rem; font-weight:800; color:#1a2a5e; }
        .schedule-block__note  { font-size:.78rem; color:#888; font-style:italic; margin-top:4px; }
        .schedule-block__shifts { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
        .schedule-shift-badge {
            background:#fff; border:1px solid #a7f3d0; border-radius:20px;
            padding:4px 14px; font-size:.82rem; font-weight:600; color:#065f46;
        }
        .benefit-list { list-style:none; padding:0; margin:0 0 16px; }
        .benefit-list li { font-size:.9rem; color:#333; padding:10px 0; border-bottom:1px solid #f0f0f0; display:flex; align-items:flex-start; gap:10px; }
        .benefit-list li::before { content:"✓"; color:#2d4090; font-weight:800; flex-shrink:0; }
        .recruit-cta { background:#f5f7fb; border-radius:8px; padding:24px 28px; margin:28px 0 0; }
        .recruit-cta__info { font-size:.85rem; color:#555; line-height:1.9; margin-bottom:16px; }
        .recruit-cta__btns { display:flex; gap:12px; flex-wrap:wrap; }
        .recruit-cta__btn { display:inline-flex; align-items:center; gap:8px; background:#1a2a5e; color:#fff; font-weight:700; font-size:.95rem; padding:12px 28px; border-radius:4px; text-decoration:none; letter-spacing:.02em; transition:background .2s; }
        .recruit-cta__btn:hover { background:#2d4090; color:#fff; }
        /* Apply form */
        .apply-form-wrap { border-top:1px solid #e8e8e8; padding:32px 0 0; margin-top:8px; }
        .apply-form-wrap h2 { font-size:1.05rem; font-weight:800; color:#1a2a5e; margin:0 0 6px; }
        .apply-form-wrap .form-note { font-size:.78rem; color:#888; margin:0 0 20px; }
        .apply-form { display:flex; flex-direction:column; gap:16px; max-width:520px; }
        .apply-form__group { display:flex; flex-direction:column; gap:5px; }
        .apply-form__label { font-size:.85rem; font-weight:600; color:#333; }
        .apply-form__label span { color:#e03030; margin-left:3px; font-size:.78rem; }
        .apply-form__input { border:1.5px solid #d0d7e6; border-radius:5px; padding:10px 13px; font-size:.95rem; transition:border-color .2s; outline:none; }
        .apply-form__input:focus { border-color:#1a2a5e; }
        .apply-form__btn { align-self:flex-start; background:#1a2a5e; color:#fff; font-weight:700; font-size:.95rem; padding:12px 32px; border:none; border-radius:4px; cursor:pointer; transition:background .2s; letter-spacing:.02em; }
        .apply-form__btn:hover { background:#2d4090; }
        .apply-alert { padding:12px 16px; border-radius:5px; font-size:.9rem; margin-bottom:18px; }
        .apply-alert.-success { background:#e8f5e9; color:#2e7d32; border:1px solid #a5d6a7; }
        .apply-alert.-error   { background:#fff3e0; color:#e65100; border:1px solid #ffcc80; }
        /* Benefits video */
        .benefits-video-btn { display:inline-flex; align-items:center; gap:12px; background:#1a2a5e; color:#fff; border:none; border-radius:6px; padding:14px 24px; cursor:pointer; font-size:.95rem; font-weight:700; margin-bottom:18px; transition:background .2s; }
        .benefits-video-btn:hover { background:#2d4090; }
        .benefits-video-btn__play { font-size:1.4rem; line-height:1; }
        #benefitsVideoOverlay { position:fixed; inset:0; background:rgba(0,0,0,.75); z-index:9999; display:flex; align-items:center; justify-content:center; }
        .benefits-video-modal { position:relative; width:90%; max-width:860px; background:#000; border-radius:8px; overflow:hidden; }
        .benefits-video-close { position:absolute; top:8px; right:12px; background:none; border:none; color:#fff; font-size:2rem; cursor:pointer; line-height:1; z-index:1; opacity:.8; }
        .benefits-video-close:hover { opacity:1; }
    </style>
}

<header class="page-header inview">
    <div class="page-header__sub" lang="en">@headerSub</div>
    <h1 class="page-header__main">@headerMain</h1>
</header>

<div class="widthBase">
    <div class="breadcrumb" itemprop="breadcrumb">
        <a href="/" class="home">HOME（@(lang == "ja" ? "マイクロテクノベトナム有限会社" : "MICROTECHNO VIETNAM CO., LTD")）</a> &gt;
        <span class="post post-page current-item">@breadcrumb</span>
    </div>

    <div class="recruit-hero">
        <p class="recruit-hero__sub">@Html.Raw(heroTag)</p>
        <h2 class="recruit-hero__title">@heroTitle</h2>
        <p class="recruit-hero__desc">@Html.Raw(heroDesc)</p>
        <p class="recruit-hero__income">
            @heroIncome <strong>@heroIncomeVal</strong>
        </p>
        <p class="recruit-hero__contact">@Html.Raw(heroContact)</p>
    </div>

    <div class="recruit-stats">
        <div class="recruit-stat">
            <p class="recruit-stat__label">@stat1Label</p>
            <p class="recruit-stat__value">@stat1Val</p>
        </div>
        <div class="recruit-stat">
            <p class="recruit-stat__label">@stat2Label</p>
            <p class="recruit-stat__value">@stat2Val</p>
        </div>
        <div class="recruit-stat">
            <p class="recruit-stat__label">@stat3Label</p>
            <p class="recruit-stat__value">@stat3Val</p>
        </div>
    </div>

    <div class="recruit-section">
        <h2>@secJobs</h2>
        @{
            var jobs = ViewData["Jobs"] as List<Mitech.Web.Models.JobPosition> ?? new();
        }
        @if (jobs.Count == 0)
        {
            <p style="color:#888;font-style:italic;">Hiện chưa có vị trí tuyển dụng.</p>
        }
        else
        {
            <div class="job-grid">
                @foreach (var job in jobs)
                {
                    var jTitle = lang == "ja" ? job.TitleJa : (lang == "en" ? job.TitleEn : job.TitleVi);
                    var jDesc  = lang == "ja" ? job.ShortDescJa : (lang == "en" ? job.ShortDescEn : job.ShortDescVi);
                    <a href="/tuyen-dung/@job.Slug" class="job-card">
                        <p class="job-card__title">@jTitle</p>
                        <p class="job-card__desc">@jDesc</p>
                        <span class="job-card__cta">@secJobsCta</span>
                    </a>
                }
            </div>
        }
    </div>

    <div class="recruit-section">
        <h2>@secSchedule</h2>
        <p class="schedule-note">@Html.Raw(schedNote)</p>
        <div class="schedule-blocks">
            <div class="schedule-block schedule-block--admin">
                <div class="schedule-block__label">@sAdminLabel</div>
                <div class="schedule-block__time">@sAdminVal</div>
            </div>
            <div class="schedule-block schedule-block--day">
                <div class="schedule-block__label">@sDayLabel</div>
                <div class="schedule-block__time">@sDayVal</div>
            </div>
            <div class="schedule-block schedule-block--night">
                <div class="schedule-block__label">@sNightLabel</div>
                <div class="schedule-block__time">@sNightVal</div>
            </div>
            <div class="schedule-block schedule-block--prod">
                <div class="schedule-block__label">@sProdLabel</div>
                <div class="schedule-block__shifts">
                    <span class="schedule-shift-badge">@sShift1</span>
                    <span class="schedule-shift-badge">@sShift2</span>
                    <span class="schedule-shift-badge">@sShift3</span>
                </div>
            </div>
            <div class="schedule-block schedule-block--fixed">
                <div class="schedule-block__label">@sFixedLabel</div>
                <div class="schedule-block__time">@sFixedVal</div>
                <div class="schedule-block__note">@sFixedNote</div>
            </div>
        </div>
    </div>

    <div class="recruit-section">
        <h2>@secBenefits</h2>
        @{
            var recruitVideoUrl   = ViewData["RecruitVideoUrl"]   as string ?? "";
            var tripVideoUrl      = ViewData["TripVideoUrl"]      as string ?? "";
            var insuranceVideoUrl = ViewData["InsuranceVideoUrl"] as string ?? "";
            string videoLabel   = lang == "ja" ? "待遇・福利厚生の動画を見る" : (lang == "en" ? "Watch benefits video" : "Xem video quyền lợi nổi bật");
        }
        @if (!string.IsNullOrEmpty(recruitVideoUrl))
        {
            <button class="benefits-video-btn" type="button" onclick="openVideoModal('@recruitVideoUrl')">
                <span class="benefits-video-btn__play">&#9654;</span>
                <span class="benefits-video-btn__label">@videoLabel</span>
            </button>
        }
        <div id="benefitsVideoOverlay" style="display:none;" onclick="closeVideoModal(event)">
            <div class="benefits-video-modal">
                <button class="benefits-video-close" onclick="closeVideoModal(event)" type="button">&times;</button>
                <video id="benefitsVideo" src="" controls style="width:100%;max-height:70vh;background:#000;display:block;border-radius:6px;"></video>
            </div>
        </div>
        <ul class="benefit-list">
            <li>@b1</li>
            <li>@b2</li>
            <li>@b3</li>
            <li>@b4</li>
            @if (!string.IsNullOrEmpty(insuranceVideoUrl))
            {
                <li style="cursor:pointer;" onclick="openVideoModal('@insuranceVideoUrl')">
                    <span style="color:#2d4090;font-weight:700;margin-right:6px;">&#9654;</span>@b5
                </li>
            }
            else
            {
                <li>@b5</li>
            }
            @if (!string.IsNullOrEmpty(tripVideoUrl))
            {
                <li style="cursor:pointer;" onclick="openVideoModal('@tripVideoUrl')">
                    <span style="color:#2d4090;font-weight:700;margin-right:6px;">&#9654;</span>@b6
                </li>
            }
            else
            {
                <li>@b6</li>
            }
        </ul>
    </div>

    <div class="recruit-cta">
        <p class="recruit-cta__info">
            <strong>@ctaInterviewLabel:</strong> @Html.Raw(ctaInterviewVal)<br>
            <strong>@ctaLocationLabel:</strong> @ctaLocationVal
        </p>
        <div class="recruit-cta__btns">
            <a href="tel:02213974544" class="recruit-cta__btn">📞 022-1397-4544</a>
            <a href="tel:0901589826" class="recruit-cta__btn">📞 090-158-9826</a>
        </div>
    </div>

    <div class="apply-form-wrap">
        <h2>@formTitle</h2>
        <p class="form-note">@fRequired</p>

        @if (TempData["RecruitSuccess"] != null)
        {
            <div class="apply-alert -success">@fSuccess</div>
        }
        @if (TempData["RecruitError"] != null)
        {
            <div class="apply-alert -error">@fError</div>
        }

        <form method="post" action="/tuyen-dung" class="apply-form">
            @Html.AntiForgeryToken()
            <div class="apply-form__group">
                <label class="apply-form__label">@fName <span>*</span></label>
                <input class="apply-form__input" type="text" name="fullName" required maxlength="100" autocomplete="name">
            </div>
            <div class="apply-form__group">
                <label class="apply-form__label">@fPhone <span>*</span></label>
                <input class="apply-form__input" type="tel" name="phone" required maxlength="20" autocomplete="tel">
            </div>
            <div class="apply-form__group">
                <label class="apply-form__label">@fPosition</label>
                @{
                    var applyJobs = ViewData["Jobs"] as List<Mitech.Web.Models.JobPosition> ?? new();
                }
                @if (applyJobs.Count > 0)
                {
                    <select class="apply-form__input" name="position">
                        <option value="">— @fPositionPh —</option>
                        @foreach (var j in applyJobs)
                        {
                            var jt = lang == "ja" ? j.TitleJa : (lang == "en" ? j.TitleEn : j.TitleVi);
                            <option value="@jt">@jt</option>
                        }
                    </select>
                }
                else
                {
                    <input class="apply-form__input" type="text" name="position" maxlength="100" placeholder="@fPositionPh">
                }
            </div>
            <button type="submit" class="apply-form__btn">@fSubmit</button>
        </form>
    </div>

    <script>
    function openVideoModal(url){
        var v = document.getElementById('benefitsVideo');
        var overlay = document.getElementById('benefitsVideoOverlay');
        if(v && overlay){ v.src=url; overlay.style.display='flex'; v.play(); }
    }
    function closeVideoModal(e){
        if(e && e.target && e.target.classList.contains('benefits-video-modal')) return;
        var overlay = document.getElementById('benefitsVideoOverlay');
        if(overlay){ overlay.style.display='none'; var v=document.getElementById('benefitsVideo'); if(v){v.pause();v.currentTime=0;v.src='';} }
    }
    document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeVideoModal(); });
    </script>
    <div class="mt-lg"></div>
</div>

@await Html.PartialAsync("_ConversionSection")
