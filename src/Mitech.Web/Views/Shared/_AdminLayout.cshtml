<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | Quản trị — MICROTECHNO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    @inject Mitech.Web.Services.IPageContentService _faviconSvc
    @{ var _faviconHref = await _faviconSvc.GetAsync("site.favicon.path", "global"); }
    <link rel="icon" href="@(_faviconHref is { Length: > 0 } ? _faviconHref : "/favicon.png")" sizes="32x32">
    <style>
        :root { --sb-w: 240px; --sb-collapsed: 64px; }

        /* ── Layout ── */
        body { overflow-x: hidden; background: #f4f6f9; }
        #sidebar {
            position: fixed; top: 0; left: 0; height: 100vh; width: var(--sb-w);
            background: #212529; z-index: 1040; display: flex; flex-direction: column;
            overflow: hidden; transition: width .25s ease;
        }
        #sidebar.sb-collapsed { width: var(--sb-collapsed); }
        #main { margin-left: var(--sb-w); min-height: 100vh; transition: margin-left .25s ease; }
        #main.sb-expanded { margin-left: var(--sb-collapsed); }

        /* ── Sidebar brand ── */
        .sb-brand {
            display: flex; align-items: center; gap: 12px; padding: 0 16px;
            height: 56px; border-bottom: 1px solid rgba(255,255,255,.1); flex-shrink: 0;
            white-space: nowrap; text-decoration: none;
        }
        .sb-brand i { font-size: 1.3rem; color: #0d6efd; min-width: 20px; }
        .sb-brand-text { color: #fff; font-weight: 700; font-size: .9rem; overflow: hidden; }

        /* ── Toggle ── */
        .sb-toggle {
            position: absolute; top: 16px; right: -14px; width: 28px; height: 28px;
            background: #343a40; border: 1px solid rgba(255,255,255,.15); border-radius: 50%;
            color: rgba(255,255,255,.7); display: flex; align-items: center;
            justify-content: center; cursor: pointer; font-size: .75rem; z-index: 1050;
            transition: background .15s;
        }
        .sb-toggle:hover { background: #495057; color: #fff; }

        /* ── Nav ── */
        .sb-nav { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 8px 0; }
        .sb-nav::-webkit-scrollbar { width: 4px; }
        .sb-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 2px; }
        .sb-section {
            padding: 10px 16px 3px; font-size: .68rem; text-transform: uppercase;
            letter-spacing: .08em; color: rgba(255,255,255,.35); white-space: nowrap; overflow: hidden;
        }
        .sb-link {
            display: flex; align-items: center; gap: 12px; padding: 9px 16px;
            color: rgba(255,255,255,.7); font-size: .855rem; white-space: nowrap;
            text-decoration: none; transition: background .15s, color .15s;
        }
        .sb-link:hover { background: rgba(255,255,255,.08); color: #fff; }
        .sb-link.active { background: #0d6efd; color: #fff; }
        .sb-link i { font-size: 1rem; min-width: 20px; text-align: center; flex-shrink: 0; }
        .sb-label { overflow: hidden; }

        /* ── Collapsed: hide labels ── */
        #sidebar.sb-collapsed .sb-label,
        #sidebar.sb-collapsed .sb-section,
        #sidebar.sb-collapsed .sb-brand-text { display: none; }
        #sidebar.sb-collapsed .sb-brand { justify-content: center; padding: 0; }
        #sidebar.sb-collapsed .sb-link { justify-content: center; padding: 9px 0; }

        /* ── Topbar ── */
        #topbar {
            height: 56px; background: #fff; border-bottom: 1px solid #dee2e6;
            padding: 0 20px; display: flex; align-items: center;
            justify-content: space-between; position: sticky; top: 0; z-index: 100;
        }
        .topbar-title { font-size: .875rem; font-weight: 600; color: #6c757d; }

        /* ── Page content ── */
        .page-body { padding: 24px; }

        /* ── Compat classes (existing views unchanged) ── */
        .admin-card {
            background: #fff; border-radius: 8px; padding: 24px;
            box-shadow: 0 1px 4px rgba(0,0,0,.07); margin-bottom: 24px;
        }
        h1 { font-size: 1.4rem; margin: 0 0 20px; font-weight: 700; }
        h2 { font-size: 1.1rem; margin: 0 0 16px; border-bottom: 2px solid #212529; padding-bottom: 8px; font-weight: 700; }
        .form-group { margin-bottom: 16px; }
        .form-group > label { font-weight: 600; font-size: .875rem; margin-bottom: 4px; display: block; }
        .badge-unread { background: #dc3545; color: #fff; border-radius: 10px; padding: 2px 8px; font-size: .72rem; }
        .text-muted { color: #6c757d !important; font-size: .85rem; }
        .alert-success { background: #d1e7dd; color: #0a3622; padding: 10px 16px; border-radius: 6px; margin-bottom: 16px; border: 1px solid #a3cfbb; }
        .tabs { display: flex; gap: 4px; margin-bottom: 16px; }
        .tab { padding: 6px 14px; background: #e9ecef; border-radius: 4px; cursor: pointer; font-size: .85rem; border: none; }
        .tab.active { background: #212529; color: #fff; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #f0f0f0; font-size: .875rem; }
        th { background: #f8f9fa; font-weight: 600; color: #495057; }
        tr:hover td { background: #fafafa; }
        .btn-sm { padding: 4px 10px; font-size: .8rem; }

        /* ── Mobile ── */
        @@media (max-width: 768px) {
            #sidebar { transform: translateX(-100%); transition: transform .25s ease, width .25s ease; width: var(--sb-w) !important; }
            #sidebar.sb-mobile-open { transform: translateX(0); }
            #main { margin-left: 0 !important; }
            .sb-toggle { display: none; }
        }
    </style>
    @await RenderSectionAsync("HeadExtra", required: false)
</head>
<body>

@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<!-- ═══ SIDEBAR ═══ -->
<nav id="sidebar">
    <a href="/admin" class="sb-brand">
        <i class="bi bi-cpu-fill"></i>
        <span class="sb-brand-text">MICROTECHNO</span>
    </a>

    <button class="sb-toggle" id="sbToggle" title="Thu gọn">
        <i class="bi bi-chevron-left" id="sbToggleIcon"></i>
    </button>

    <div class="sb-nav">
        <div class="sb-section">Tổng quan</div>
        <a href="/admin" class="sb-link @(ctrl == "Dashboard" ? "active" : "")">
            <i class="bi bi-speedometer2"></i><span class="sb-label">Dashboard</span>
        </a>

        <div class="sb-section" style="margin-top:4px;">Nội dung</div>
        <a href="/admin/productsadmin" class="sb-link @(ctrl == "ProductsAdmin" ? "active" : "")">
            <i class="bi bi-box-seam"></i><span class="sb-label">Sản phẩm</span>
        </a>
        <a href="/admin/newsadmin" class="sb-link @(ctrl == "NewsAdmin" ? "active" : "")">
            <i class="bi bi-newspaper"></i><span class="sb-label">Tin tức</span>
        </a>
        <a href="/admin/jobs" class="sb-link @(ctrl == "JobsAdmin" ? "active" : "")">
            <i class="bi bi-briefcase"></i><span class="sb-label">Tuyển dụng</span>
        </a>
        <a href="/admin/recruitmentadmin" class="sb-link @(ctrl == "RecruitmentAdmin" ? "active" : "")">
            <i class="bi bi-megaphone"></i><span class="sb-label">Nội dung Tuyển dụng</span>
        </a>
        <a href="/admin/contactadmin" class="sb-link @(ctrl == "ContactAdmin" ? "active" : "")">
            <i class="bi bi-envelope"></i><span class="sb-label">Liên hệ</span>
        </a>

        <div class="sb-section" style="margin-top:4px;">Cấu hình</div>
        <a href="/admin/pagesadmin" class="sb-link @(ctrl == "PagesAdmin" ? "active" : "")">
            <i class="bi bi-file-text"></i><span class="sb-label">Nội dung trang</span>
        </a>
        <a href="/admin/homesettings" class="sb-link @(ctrl == "HomeSettingsAdmin" ? "active" : "")">
            <i class="bi bi-gear"></i><span class="sb-label">Cài đặt</span>
        </a>
        <a href="/admin/nav" class="sb-link @(ctrl == "Nav" ? "active" : "")">
            <i class="bi bi-list-ul"></i><span class="sb-label">Menu</span>
        </a>
        <a href="/admin/footer" class="sb-link @(ctrl == "Footer" ? "active" : "")">
            <i class="bi bi-layout-bottom"></i><span class="sb-label">Footer</span>
        </a>
        <a href="/admin/maintenance" class="sb-link @(ctrl == "MaintenanceAdmin" ? "active" : "")">
            <i class="bi bi-cone-striped"></i><span class="sb-label">Bảo trì</span>
        </a>
    </div>

    <div style="border-top:1px solid rgba(255,255,255,.1);padding:4px 0;flex-shrink:0;">
        <form asp-controller="Login" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="sb-link w-100 border-0 bg-transparent" style="color:rgba(255,120,120,.85);cursor:pointer;">
                <i class="bi bi-box-arrow-right"></i><span class="sb-label">Đăng xuất</span>
            </button>
        </form>
    </div>
</nav>

<!-- ═══ MAIN ═══ -->
<div id="main">
    <div id="topbar">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary d-md-none" id="sbMobileToggle">
                <i class="bi bi-list"></i>
            </button>
            <span class="topbar-title">@ViewData["Title"]</span>
        </div>
        <a href="/" target="_blank" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-arrow-up-right me-1"></i>Xem trang web
        </a>
    </div>

    <div class="page-body">
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    var sb = document.getElementById('sidebar');
    var main = document.getElementById('main');
    var icon = document.getElementById('sbToggleIcon');
    var collapsed = localStorage.getItem('sbCollapsed') === '1';

    function apply() {
        sb.classList.toggle('sb-collapsed', collapsed);
        main.classList.toggle('sb-expanded', collapsed);
        icon.className = collapsed ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
    }

    apply();

    document.getElementById('sbToggle').addEventListener('click', function () {
        collapsed = !collapsed;
        localStorage.setItem('sbCollapsed', collapsed ? '1' : '0');
        apply();
    });

    var mBtn = document.getElementById('sbMobileToggle');
    if (mBtn) {
        mBtn.addEventListener('click', function () {
            sb.classList.toggle('sb-mobile-open');
        });
    }
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
