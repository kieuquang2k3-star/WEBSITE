@section PageCss {
    <link rel="stylesheet" href="/css/page.css">
    <link rel="stylesheet" href="/css/pages/page-about-us.css">
    <style>
        .history__item--award .history__year { color:inherit; }
        .award-card { display:flex; gap:28px; align-items:flex-start; flex:1; }
        .award-card__body { flex:1; }
        .award-card__title { font-weight:700; color:#1a2a5e; font-size:1.05em; margin:0 0 3px; }
        .award-card__sub { font-size:.88em; color:#777; font-style:italic; margin:0 0 10px; }
        .award-card__desc { font-size:.875em; color:#444; line-height:1.75; margin:0 0 8px; }
        .award-card__img { flex:0 0 140px; text-align:center; }
        .award-card__img img { width:100%; max-width:140px; height:auto; display:block; margin:0 auto; }
        @@media(max-width:600px){
            .award-card { flex-direction:column-reverse; gap:16px; }
            .award-card__img { width:120px; }
        }
        .iso-badge { margin:30px 0 0; text-align:center; }
        .iso-badge img { width:128px; height:auto; display:block; margin:0 auto; border:1px solid #eee; border-radius:4px; }
    </style>
}

