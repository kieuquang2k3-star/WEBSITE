</header>

<div class="widthBase">
    <div class="breadcrumb" itemprop="breadcrumb">
        <a href="/" class="home">@breadcrumbHome</a> &gt;
        <span class="post post-page current-item">@pageTitle</span>
    </div>
</div>

<div class="widthBase">
    <div class="section">
        <ul class="page-link mt-md">
            <li class="page-link__item"><a href="#" class="page-link__link" data-anchor="philosophy">@philoTitle</a></li>
            <li class="page-link__item"><a href="#" class="page-link__link" data-anchor="message">@msgTitle</a></li>
            <li class="page-link__item"><a href="#" class="page-link__link" data-anchor="history-vietnam">@vietnamHistTitle</a></li>
            <li class="page-link__item"><a href="#" class="page-link__link" data-anchor="key-customers">@custTitle</a></li>
            <li class="page-link__item"><a href="#" class="page-link__link" data-anchor="mvc-products">@productsTitle</a></li>
            <li class="page-link__item"><a href="#" class="page-link__link" data-anchor="quality-motto">@qualMottoTitle</a></li>
            <li class="page-link__item"><a href="#" class="page-link__link" data-anchor="env-motto">@envMottoTitle</a></li>
        </ul>

        <div class="about-banner" style="margin-top:20px;">
            <img src="/images/banner-doi-ngu.jpg" alt="" loading="lazy" style="width:100%;height:auto;display:block;border-radius:4px;">
        </div>

        <section id="philosophy">
            <h2>@philoTitle</h2>
            <p class="catch-phrase">@Html.Raw(philoCatch)</p>
        </section>

        <section id="message">
            <h2>@msgTitle</h2>
            <div class="message-txt">
                <div class="half">
                    <div class="half__item">
                        <p>@presMsg1</p>
                        <p>@presMsg2</p>
                    </div>
                    <div class="half__item">
                        <p>@presMsg3</p>
                        <p>@presMsg4</p>
                        <p class="signature">@sigName<br>@Html.Raw(sigTitle)</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="history-vietnam">
            <h2>@vietnamHistTitle</h2>
            <dl class="history">
                @if (lang == "ja")
                {
                    <div class="history__item"><dt class="history__year">2014</dt><dd><p class="history__month">7月</p><p class="history__txt">工場設立</p></dd></div>
                    <div class="history__item"><dt class="history__year">2016</dt><dd><p class="history__month">12月</p><p class="history__txt">ISO 9001:2015 取得</p></dd></div>
                    <div class="history__item"><dt class="history__year">2018</dt><dd><p class="history__month">3月</p><p class="history__txt">ISO 14001:2015 取得</p></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2018</dt><dd><p class="history__month">6月</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Effort for New Project Award 2018 受賞</p><p class="award-card__sub">新規プロジェクト立ち上げ貢献賞</p><p class="award-card__desc">MICROTECHNO VIETNAMは、新規プロジェクトの立ち上げおよび量産化への貢献が評価され、DENSOよりEffort for New Project Award 2018を授与されました。</p><p class="award-card__desc">このアワードは、迅速な対応力、顧客との緊密な連携、そして戦略的プロジェクトにおける品質・納期・安定性の確保に向けた高い責任感を示すものです。</p></div><figure class="award-card__img"><img src="/images/4.png" alt="DENSO Effort for New Project Award 2018" loading="lazy"></figure></div></dd></div>
                    <div class="history__item"><dt class="history__year">2019</dt><dd><p class="history__month">8月</p><p class="history__txt">工場拡張：3,200 → 7,890 m²</p></dd></div>
                    <div class="history__item"><dt class="history__year">2020</dt><dd><p class="history__month">5月</p><p class="history__txt">日本向け輸出開始</p></dd></div>
                    <div class="history__item"><dt class="history__year">2020</dt><dd><p class="history__month">6月</p><p class="history__txt">メキシコ向け輸出開始</p></dd></div>
                    <div class="history__item"><dt class="history__year">2020</dt><dd><p class="history__month">10月</p><p class="history__txt">中国向け輸出開始</p></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2021</dt><dd><p class="history__month">6月</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Collaboration Award 2021 受賞</p><p class="award-card__sub">協力・連携貢献賞</p><p class="award-card__desc">2021年、DENSOより生産活動・改善・サプライチェーン発展における効果的な協力体制と積極的な貢献を評価され、Collaboration Award 2021を授与されました。</p><p class="award-card__desc">このアワードはMICROTECHNO VIETNAMとDENSOとの持続的なパートナーシップの証であり、顧客と歩みを共にし長期的な価値を創出する協調力の高さを示すものです。</p></div><figure class="award-card__img"><img src="/images/5.png" alt="DENSO Collaboration Award 2021" loading="lazy"></figure></div></dd></div>
                    <div class="history__item"><dt class="history__year">2022</dt><dd><p class="history__month"></p><p class="history__txt">日本向け新規部品輸出開始</p></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2024</dt><dd><p class="history__month">6月</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Quality Contribution Award 2024 受賞</p><p class="award-card__sub">品質貢献賞 2024</p><p class="award-card__desc">2025年のDENSOサプライヤーカンファレンスにて、製品品質の向上とサプライチェーン信頼性への顕著な貢献が評価され、Quality Contribution Award 2024を授与されました。</p><p class="award-card__desc">このアワードは、品質マネジメントシステム、リスク管理能力、そして自動車産業の厳格な要件への対応力に対するお客様からの高い評価を示すものです。</p></div><figure class="award-card__img"><img src="/images/3.png" alt="DENSO Quality Contribution Award 2024" loading="lazy"></figure></div></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2025</dt><dd><p class="history__month">6月</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">佐久間グループより Preferred Supplier 認定（2021年より継続）</p><p class="award-card__sub">優先サプライヤー認定</p><p class="award-card__desc">2025年、MICROTECHNO VIETNAMは引き続き佐久間グループ（日本）よりPreferred Supplier（優先サプライヤー）として認定されました。これは安定した品質維持能力と日本の製造・管理基準への厳格な対応力の証です。</p><p class="award-card__desc">この認定は2021年の初回認定以来継続しており、生産能力・品質管理システム・継続的改善へのコミットメントに対するパートナーからの長期的な信頼を示しています。</p></div><figure class="award-card__img"><img src="/images/1.png" alt="Sasaki Preferred Supplier 2025" loading="lazy"></figure></div></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2025</dt><dd><p class="history__month">6月</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Excellent Cost Award 2025 受賞</p><p class="award-card__sub">コスト最適化優秀賞 2025</p><p class="award-card__desc">MICROTECHNO VIETNAMは、世界有数の自動車部品メーカーであるDENSOより、Excellent Cost Award 2025を受賞しました。</p><p class="award-card__desc">このアワードは、製造プロセスの最適化、業務効率の向上、グローバル品質基準を維持しながらのコスト削減における卓越した取り組みを評価するものです。カイゼン精神と全部門の緊密な連携による成果です。</p></div><figure class="award-card__img"><img src="/images/2.png" alt="DENSO Excellent Cost Award 2025" loading="lazy"></figure></div></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2026</dt><dd><p class="history__month">6月</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">MAZDA MPMT Continuous Quality Supplier Award（3年連続）</p><p class="award-card__sub">「不良ゼロ」品質への貢献 ― 佐久間（タイランド）</p><p class="award-card__desc">2026年6月、佐久間（タイランド）は、Mazda Powertrain Manufacturing Thailand向け購入部品の2024年度品質において「不良ゼロ」を達成し、MAZDA MPMT Continuous Quality Supplier Award（3年連続）を授与されました。</p><p class="award-card__desc">佐久間（タイランド）は、この受賞に重要な役割を果たしたMICROTECHNO VIETNAMの支援と貢献に対し、深い感謝の意を表しました。これは当社の品質管理能力とパートナーとの協働の証です。</p></div><figure class="award-card__img"><img src="/images/7.png" alt="MAZDA MPMT Continuous Quality Supplier Award — Sakuma (Thailand) / MICROTECHNO VIETNAM" loading="lazy"></figure></div></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2026</dt><dd><p class="history__month">6月</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Overall Outstanding Award 2026 受賞</p><p class="award-card__sub">総合優秀賞 2026</p><p class="award-card__desc">2026年6月26日、MICROTECHNO VIETNAMはDENSOよりOverall Outstanding Award 2026（総合優秀賞）を授与されました。これは全評価項目において卓越した成果を収めたサプライヤーに贈られる、最高位の総合表彰です。</p><p class="award-card__desc">品質・コスト・納期・協力体制のすべてにおける総合力が高く評価された結果であり、これまで積み重ねてきた継続的改善と、お客様と共に歩む姿勢が実を結んだものです。</p></div><figure class="award-card__img"><img src="/images/8.png" alt="DENSO Overall Outstanding Award 2026" loading="lazy"></figure></div></dd></div>
                }
                else if (lang == "vi")
                {
                    <div class="history__item"><dt class="history__year">2014</dt><dd><p class="history__month">Tháng 7</p><p class="history__txt">Thành lập nhà máy</p></dd></div>
                    <div class="history__item"><dt class="history__year">2016</dt><dd><p class="history__month">Tháng 12</p><p class="history__txt">Đạt chứng nhận ISO 9001:2015</p></dd></div>
                    <div class="history__item"><dt class="history__year">2018</dt><dd><p class="history__month">Tháng 3</p><p class="history__txt">Đạt chứng nhận ISO 14001:2015</p></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2018</dt><dd><p class="history__month">Tháng 6</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Effort for New Project Award 2018</p><p class="award-card__sub">Giải thưởng Nỗ lực Triển khai Dự án Mới năm 2018</p><p class="award-card__desc">MICROTECHNO VIETNAM đã được DENSO trao tặng giải thưởng Effort for New Project Award 2018 nhằm ghi nhận những đóng góp tích cực trong quá trình triển khai và đưa các dự án mới vào sản xuất.</p><p class="award-card__desc">Giải thưởng phản ánh khả năng đáp ứng nhanh, phối hợp hiệu quả với khách hàng và tinh thần trách nhiệm cao trong việc đảm bảo tiến độ, chất lượng cũng như tính ổn định của các dự án chiến lược.</p></div><figure class="award-card__img"><img src="/images/4.png" alt="DENSO Effort for New Project Award 2018" loading="lazy"></figure></div></dd></div>
                    <div class="history__item"><dt class="history__year">2019</dt><dd><p class="history__month">Tháng 8</p><p class="history__txt">Mở rộng nhà máy: 3,200 → 7,890 m²</p></dd></div>
                    <div class="history__item"><dt class="history__year">2020</dt><dd><p class="history__month">Tháng 5</p><p class="history__txt">Bắt đầu xuất khẩu sang Nhật Bản</p></dd></div>
                    <div class="history__item"><dt class="history__year">2020</dt><dd><p class="history__month">Tháng 6</p><p class="history__txt">Bắt đầu xuất khẩu sang Mexico</p></dd></div>
                    <div class="history__item"><dt class="history__year">2020</dt><dd><p class="history__month">Tháng 10</p><p class="history__txt">Bắt đầu xuất khẩu sang Trung Quốc</p></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2021</dt><dd><p class="history__month">Tháng 6</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Collaboration Award 2021</p><p class="award-card__sub">Giải thưởng Hợp tác Xuất sắc năm 2021</p><p class="award-card__desc">Năm 2021, MICROTECHNO VIETNAM vinh dự nhận Collaboration Award từ DENSO nhằm ghi nhận sự hợp tác hiệu quả và những đóng góp tích cực trong hoạt động sản xuất, cải tiến và phát triển chuỗi cung ứng.</p><p class="award-card__desc">Giải thưởng là minh chứng cho mối quan hệ đối tác bền vững giữa MICROTECHNO VIETNAM và DENSO, đồng thời khẳng định năng lực phối hợp, tinh thần đồng hành cùng khách hàng để tạo ra những giá trị lâu dài và bền vững.</p></div><figure class="award-card__img"><img src="/images/5.png" alt="DENSO Collaboration Award 2021" loading="lazy"></figure></div></dd></div>
                    <div class="history__item"><dt class="history__year">2022</dt><dd><p class="history__month"></p><p class="history__txt">Bắt đầu triển khai sản xuất G4</p></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2024</dt><dd><p class="history__month">Tháng 6</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Quality Contribution Award 2024</p><p class="award-card__sub">Giải thưởng Đóng góp Chất lượng năm 2024</p><p class="award-card__desc">Tại Hội nghị Nhà cung cấp DENSO năm 2025, MICROTECHNO VIETNAM được trao Quality Contribution Award 2024 nhằm ghi nhận những đóng góp nổi bật trong việc nâng cao chất lượng sản phẩm và độ tin cậy của chuỗi cung ứng.</p><p class="award-card__desc">Giải thưởng thể hiện sự đánh giá cao từ khách hàng đối với hệ thống quản lý chất lượng, khả năng kiểm soát rủi ro và cam kết đáp ứng các yêu cầu khắt khe của ngành công nghiệp ô tô.</p></div><figure class="award-card__img"><img src="/images/3.png" alt="DENSO Quality Contribution Award 2024" loading="lazy"></figure></div></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2025</dt><dd><p class="history__month">Tháng 6</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">Chứng nhận Nhà cung cấp Ưu tiên năm 2025</p><p class="award-card__sub">Chứng nhận Nhà cung cấp Ưu tiên từ Tập đoàn Sasaki</p><p class="award-card__desc">Năm 2025, MICROTECHNO VIETNAM tiếp tục được Tập đoàn Sasaki (Nhật Bản) công nhận là Nhà cung cấp Ưu tiên (Preferred Supplier). Đây là minh chứng cho năng lực duy trì chất lượng ổn định, đáp ứng nghiêm ngặt các tiêu chuẩn sản xuất và quản lý của khách hàng Nhật Bản.</p><p class="award-card__desc">Danh hiệu này được duy trì từ lần chứng nhận đầu tiên năm 2021, thể hiện sự tin tưởng lâu dài của đối tác đối với năng lực sản xuất, hệ thống kiểm soát chất lượng và cam kết cải tiến liên tục của MICROTECHNO VIETNAM.</p></div><figure class="award-card__img"><img src="/images/1.png" alt="Sasaki Preferred Supplier 2025" loading="lazy"></figure></div></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2025</dt><dd><p class="history__month">Tháng 6</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Excellent Cost Award 2025</p><p class="award-card__sub">Giải thưởng Xuất sắc về Tối ưu Chi phí năm 2025</p><p class="award-card__desc">MICROTECHNO VIETNAM vinh dự nhận Excellent Cost Award 2025 từ DENSO – một trong những tập đoàn sản xuất linh kiện ô tô hàng đầu thế giới.</p><p class="award-card__desc">Giải thưởng ghi nhận những nỗ lực vượt trội trong việc tối ưu hóa quy trình sản xuất, nâng cao hiệu quả vận hành và giảm chi phí mà vẫn đảm bảo chất lượng sản phẩm theo tiêu chuẩn toàn cầu. Đây là thành quả của tinh thần cải tiến liên tục (Kaizen) và sự phối hợp chặt chẽ giữa các bộ phận trong toàn công ty.</p></div><figure class="award-card__img"><img src="/images/2.png" alt="DENSO Excellent Cost Award 2025" loading="lazy"></figure></div></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2026</dt><dd><p class="history__month">Tháng 6</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">MAZDA MPMT Continuous Quality Supplier Award (3 năm liên tiếp)</p><p class="award-card__sub">Ghi nhận đóng góp cho chất lượng "0 lỗi" — Sakuma (Thailand)</p><p class="award-card__desc">Tháng 6/2026, Sakuma (Thailand) Co., Ltd được trao giải thưởng MAZDA MPMT Continuous Quality Supplier Award (3 năm liên tiếp) nhờ thành tích "0 lỗi" đối với chất lượng linh kiện năm 2024 cung cấp cho Mazda Powertrain Manufacturing Thailand.</p><p class="award-card__desc">Sakuma (Thailand) đã gửi lời tri ân tới MICROTECHNO VIETNAM vì những hỗ trợ và đóng góp quan trọng, góp phần làm nên thành tựu này — minh chứng cho năng lực kiểm soát chất lượng và tinh thần đồng hành cùng đối tác.</p></div><figure class="award-card__img"><img src="/images/7.png" alt="MAZDA MPMT Continuous Quality Supplier Award — Sakuma (Thailand) / MICROTECHNO VIETNAM" loading="lazy"></figure></div></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2026</dt><dd><p class="history__month">Tháng 6</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Overall Outstanding Award 2026</p><p class="award-card__sub">Giải thưởng Xuất sắc Toàn diện năm 2026</p><p class="award-card__desc">Ngày 26/06/2026, MICROTECHNO VIETNAM vinh dự nhận giải thưởng Overall Outstanding Award 2026 từ DENSO — danh hiệu cao nhất dành cho nhà cung cấp đạt thành tích xuất sắc trên toàn bộ các tiêu chí đánh giá.</p><p class="award-card__desc">Giải thưởng ghi nhận năng lực toàn diện của công ty về chất lượng, chi phí, tiến độ giao hàng và tinh thần hợp tác. Đây là thành quả của quá trình cải tiến liên tục và sự đồng hành bền bỉ cùng khách hàng trong nhiều năm qua.</p></div><figure class="award-card__img"><img src="/images/8.png" alt="DENSO Overall Outstanding Award 2026" loading="lazy"></figure></div></dd></div>
                }
                else
                {
                    <div class="history__item"><dt class="history__year">2014</dt><dd><p class="history__month">Jul</p><p class="history__txt">Factory established</p></dd></div>
                    <div class="history__item"><dt class="history__year">2016</dt><dd><p class="history__month">Dec</p><p class="history__txt">Obtained ISO 9001:2015 certification</p></dd></div>
                    <div class="history__item"><dt class="history__year">2018</dt><dd><p class="history__month">Mar</p><p class="history__txt">Obtained ISO 14001:2015 certification</p></dd></div>
                    <div class="history__item history__item--award"><dt class="history__year">2018</dt><dd><p class="history__month">Jun</p><div class="award-card"><div class="award-card__body"><p class="award-card__title">DENSO Effort for New Project Award 2018</p><p class="award-card__sub">Excellence in New Project Launch</p><p class="award-card__desc">MICROTECHNO VIETNAM received the DENSO Effort for New Project Award 2018 in recognition of its active contribution to launching new projects into mass production.</p><p class="award-card__desc">The award reflects our ability to respond quickly, collaborate effectively with customers, and demonstrate a high sense of responsibility in ensuring the schedule, quality, and stability of strategic projects.</p></div><figure class="award-card__img"><img src="/images/4.png" alt="DENSO Effort for New Project Award 2018" loading="lazy"></figure></div></dd></div>
