@{
    ViewData["Title"] = "Đăng nhập quản trị";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập quản trị — MICROTECHNO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background: #1a1f2e; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { width: 380px; border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.35); }
        .login-header { background: #212529; border-radius: 12px 12px 0 0; padding: 28px 32px 24px; text-align: center; }
        .login-body { padding: 28px 32px 32px; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <i class="bi bi-cpu-fill text-primary" style="font-size:2rem;"></i>
            <div class="text-white fw-bold mt-2" style="font-size:1.1rem;">MICROTECHNO</div>
            <div class="text-white-50 small mt-1">Trang quản trị</div>
        </div>
        <div class="login-body bg-white">
            @if (ViewData["Error"] != null)
            {
                <div class="alert alert-danger py-2 small">
                    <i class="bi bi-exclamation-triangle me-1"></i>@Html.Raw(ViewData["Error"])
                </div>
            }

            <form asp-controller="Login" asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]">

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input type="email" name="email" class="form-control" autocomplete="username"
                               placeholder="admin@example.com" required autofocus>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold small">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" name="password" class="form-control"
                               autocomplete="current-password" placeholder="••••••••" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                </button>
            </form>
        </div>
    </div>
</body>
</html>
