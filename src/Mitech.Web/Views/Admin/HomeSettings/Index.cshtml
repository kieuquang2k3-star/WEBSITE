@* ====== NỘI DUNG VĂN BẢN ====== *@
<div class="admin-card">
    <h2>Nội dung văn bản trang chủ</h2>

    <ul class="nav nav-tabs mb-3" id="langTabs" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-vi">Tiếng Việt</button></li>
        <li class="nav-item"><button class="nav-link"        data-bs-toggle="tab" data-bs-target="#tab-ja">日本語</button></li>
        <li class="nav-item"><button class="nav-link"        data-bs-toggle="tab" data-bs-target="#tab-en">English</button></li>
    </ul>

    <div class="tab-content">
        @foreach (var (lang, labelLang) in new[] { ("vi", "VI"), ("ja", "JA"), ("en", "EN") })
        {
            <div class="tab-pane fade @(lang == "vi" ? "show active" : "")" id="tab-@lang">
                <form asp-controller="HomeSettingsAdmin" asp-action="SaveText" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="lang" value="@lang">

                    <h3 style="font-size:1rem;margin:16px 0 8px;color:#555;">Lời giới thiệu</h3>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <div class="form-group">
                            <label>Tiêu đề dòng 1</label>
                            <input type="text" name="home.intro.main1" class="form-control" value="@T(lang, "home.intro.main1")">
                        </div>
                        <div class="form-group">
                            <label>Tiêu đề dòng 2</label>
                            <input type="text" name="home.intro.main2" class="form-control" value="@T(lang, "home.intro.main2")">
                        </div>
                    </div>
                    <div class="form-group mt-2">
                        <label>Đoạn văn 1</label>
                        <input type="text" name="home.intro.sub1" class="form-control" value="@T(lang, "home.intro.sub1")">
                    </div>
                    <div class="form-group">
                        <label>Đoạn văn 2</label>
                        <input type="text" name="home.intro.sub2" class="form-control" value="@T(lang, "home.intro.sub2")">
                    </div>
                    <div class="form-group">
                        <label>Đoạn văn 3</label>
                        <input type="text" name="home.intro.sub3" class="form-control" value="@T(lang, "home.intro.sub3")">
                    </div>

                    <h3 style="font-size:1rem;margin:16px 0 8px;color:#555;">Thế mạnh</h3>
                    <div class="form-group">
                        <label>Tiêu đề mục</label>
                        <input type="text" name="home.strength.title" class="form-control" value="@T(lang, "home.strength.title")">
                    </div>
                    @for (int i = 1; i <= 3; i++)
                    {
                        <div style="margin-top:8px;padding-top:8px;border-top:1px solid #eee;">
                            <div class="form-group">
                                <label>Thế mạnh @i — tiêu đề</label>
                                <input type="text" name="home.strength@(i).line1" class="form-control" value="@T(lang, $"home.strength{i}.line1")">
                            </div>
                            <div class="form-group">
                                <label>Thế mạnh @i — mô tả (đoạn 1)</label>
                                <textarea name="home.strength@(i).line2" class="form-control" rows="2">@T(lang, $"home.strength{i}.line2")</textarea>
                            </div>
                            <div class="form-group">
                                <label>Thế mạnh @i — mô tả (đoạn 2)</label>
                                <textarea name="home.strength@(i).line3" class="form-control" rows="2">@T(lang, $"home.strength{i}.line3")</textarea>
                            </div>
                        </div>
                    }

                    <h3 style="font-size:1rem;margin:16px 0 8px;color:#555;">Banner</h3>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <div class="form-group"><label>Sản phẩm</label><input type="text" name="home.banner.products"  class="form-control" value="@T(lang, "home.banner.products")"></div>
                        <div class="form-group"><label>Về chúng tôi</label><input type="text" name="home.banner.about"  class="form-control" value="@T(lang, "home.banner.about")"></div>
                        <div class="form-group"><label>Công ty</label><input type="text" name="home.banner.company"  class="form-control" value="@T(lang, "home.banner.company")"></div>
                        <div class="form-group"><label>Địa điểm</label><input type="text" name="home.banner.locations" class="form-control" value="@T(lang, "home.banner.locations")"></div>
                    </div>

                    <h3 style="font-size:1rem;margin:16px 0 8px;color:#555;">Tin tức</h3>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <div class="form-group"><label>Tiêu đề mục</label><input type="text" name="home.news.heading" class="form-control" value="@T(lang, "home.news.heading")"></div>
                        <div class="form-group"><label>Nút "Xem tất cả"</label><input type="text" name="home.news.more" class="form-control" value="@T(lang, "home.news.more")"></div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">Lưu nội dung @labelLang</button>
                </form>
            </div>
        }
    </div>
</div>
