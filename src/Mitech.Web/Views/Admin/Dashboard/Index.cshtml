@{
    ViewData["Title"] = "Tổng quan";
    Layout = "_AdminLayout";
    var productCount = (int)(ViewData["ProductCount"] ?? 0);
    var newsCount    = (int)(ViewData["NewsCount"] ?? 0);
    var msgCount     = (int)(ViewData["MessageCount"] ?? 0);
    var unreadCount  = (int)(ViewData["UnreadCount"] ?? 0);
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card d-flex align-items-center gap-3 mb-0">
            <div style="width:48px;height:48px;background:#e7f0fd;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-box-seam" style="font-size:1.4rem;color:#0d6efd;"></i>
            </div>
            <div>
                <div style="font-size:1.75rem;font-weight:800;color:#212529;line-height:1.1;">@productCount</div>
                <div style="font-size:.8rem;color:#6c757d;margin-top:2px;">Sản phẩm</div>
            </div>
            <a href="/admin/productsadmin" class="btn btn-sm btn-outline-primary ms-auto">Quản lý</a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card d-flex align-items-center gap-3 mb-0">
            <div style="width:48px;height:48px;background:#e8f5e9;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-newspaper" style="font-size:1.4rem;color:#198754;"></i>
            </div>
            <div>
                <div style="font-size:1.75rem;font-weight:800;color:#212529;line-height:1.1;">@newsCount</div>
                <div style="font-size:.8rem;color:#6c757d;margin-top:2px;">Bài tin tức</div>
            </div>
            <a href="/admin/newsadmin" class="btn btn-sm btn-outline-success ms-auto">Quản lý</a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card d-flex align-items-center gap-3 mb-0">
            <div style="width:48px;height:48px;background:#fff3e0;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-envelope" style="font-size:1.4rem;color:#fd7e14;"></i>
            </div>
            <div>
                <div style="font-size:1.75rem;font-weight:800;color:#212529;line-height:1.1;">@msgCount</div>
                <div style="font-size:.8rem;color:#6c757d;margin-top:2px;">
                    Liên hệ
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-danger ms-1" style="font-size:.68rem;">@unreadCount chưa đọc</span>
                    }
                </div>
            </div>
            <a href="/admin/contactadmin" class="btn btn-sm btn-outline-warning ms-auto">Xem</a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card d-flex align-items-center gap-3 mb-0">
            <div style="width:48px;height:48px;background:#fce4ec;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-briefcase" style="font-size:1.4rem;color:#e91e63;"></i>
            </div>
            <div>
                <div style="font-size:1.75rem;font-weight:800;color:#212529;line-height:1.1;">—</div>
                <div style="font-size:.8rem;color:#6c757d;margin-top:2px;">Tuyển dụng</div>
            </div>
            <a href="/admin/jobs" class="btn btn-sm btn-outline-danger ms-auto">Quản lý</a>
        </div>
    </div>
</div>

<div class="admin-card">
    <h2>Thao tác nhanh</h2>
    <div class="d-flex flex-wrap gap-2">
        <a href="/admin/productsadmin/create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm
        </a>
        <a href="/admin/newsadmin/create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Thêm tin tức
        </a>
        <a href="/admin/jobs/create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Thêm vị trí tuyển dụng
        </a>
        <a href="/admin/pagesadmin" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i>Chỉnh sửa nội dung trang
        </a>
    </div>
</div>
