@model Product
@{
    ViewData["Title"] = "Thêm sản phẩm";
    Layout = "_AdminLayout";
}

<h1>Thêm sản phẩm</h1>
<a href="/admin/products" class="btn btn-secondary btn-sm" style="margin-bottom:16px;">← Quay lại danh sách</a>

<div class="admin-card">
    <form asp-controller="ProductsAdmin" asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="form-group">
                <label>Tên sản phẩm (Tiếng Nhật)</label>
                <input asp-for="TitleJa" class="form-control" required>
            </div>
            <div class="form-group">
                <label>Tên sản phẩm (Tiếng Anh)</label>
                <input asp-for="TitleEn" class="form-control">
            </div>
            <div class="form-group">
                <label>Tên sản phẩm (Tiếng Việt)</label>
                <input asp-for="TitleVi" class="form-control">
            </div>
            <div class="form-group">
                <label>Tên thông số (Tiếng Nhật)</label>
                <input asp-for="SpecName" class="form-control">
            </div>
            <div class="form-group">
                <label>Tên thông số (Tiếng Anh)</label>
                <input asp-for="SpecNameEn" class="form-control">
            </div>
            <div class="form-group">
                <label>Tên thông số (Tiếng Việt)</label>
                <input asp-for="SpecNameVi" class="form-control">
            </div>
            <div class="form-group">
                <label>Vật liệu (Tiếng Nhật)</label>
                <input asp-for="SpecMaterial" class="form-control">
            </div>
            <div class="form-group">
                <label>Vật liệu (Tiếng Anh)</label>
                <input asp-for="SpecMaterialEn" class="form-control">
            </div>
            <div class="form-group">
                <label>Vật liệu (Tiếng Việt)</label>
                <input asp-for="SpecMaterialVi" class="form-control">
            </div>
            <div class="form-group">
                <label>Kích thước (Tiếng Nhật)</label>
                <input asp-for="SpecDimension" class="form-control">
            </div>
            <div class="form-group">
                <label>Kích thước (Tiếng Anh)</label>
                <input asp-for="SpecDimensionEn" class="form-control">
            </div>
            <div class="form-group">
                <label>Kích thước (Tiếng Việt)</label>
                <input asp-for="SpecDimensionVi" class="form-control">
            </div>
            <div class="form-group">
                <label>Thứ tự hiển thị</label>
                <input asp-for="SortOrder" type="number" class="form-control" value="1">
            </div>
            <div class="form-group">
                <label>Hiển thị</label>
                <input asp-for="IsActive" type="checkbox" checked> Hiển thị công khai
            </div>
            <div class="form-group">
                <label>Ảnh sản phẩm</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*">
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Lưu</button>
    </form>
</div>
