@{
    ViewData["Title"] = "Cài đặt menu điều hướng";
    Layout = "_AdminLayout";

    var navContent = ViewData["NavContent"] as Dictionary<string, Dictionary<string, string>>
                     ?? new Dictionary<string, Dictionary<string, string>>();

    string T(string lang, string key, string fallback = "") =>
        navContent.TryGetValue(lang, out var d) && d.TryGetValue(key, out var v) ? v : fallback;

    var items = new[]
    {
        ("nav.top",       "Trang chủ",              "トップページ",           "Top"),
        ("nav.products",  "Sản phẩm",               "製品情報",               "Products"),
        ("nav.about",     "Về chúng tôi",            "マイクロテクノについて", "About us"),
        ("nav.company",   "Giới thiệu công ty",      "会社概要",               "Company"),
        ("nav.locations", "Địa điểm",                "拠点情報",               "Locations"),
        ("nav.news",      "Tin tức",                 "新着情報",               "News"),
        ("nav.contact",   "Liên hệ",                 "お問い合わせ",           "Contact"),
        ("nav.recruit",   "Tuyển dụng (để trống=ẩn)","採用情報（空欄=非表示）","Recruitment (empty=hidden)"),
    };
}

<h1>Cài đặt menu điều hướng</h1>
<p style="color:#666;font-size:.88rem;margin:-8px 0 20px;">Thay đổi tên hiển thị các mục menu theo từng ngôn ngữ. Mục <strong>Tuyển dụng</strong> nếu để trống sẽ bị ẩn với ngôn ngữ đó.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="admin-card">
    <style>
        .nav-tabs-custom { display:flex; gap:4px; margin-bottom:20px; border-bottom:2px solid #eee; }
        .nav-tab-btn { padding:8px 22px; cursor:pointer; border-radius:4px 4px 0 0; font-size:.9rem; background:#f0f0f0; border:none; font-weight:600; }
        .nav-tab-btn.active { background:#1a1a2e; color:#fff; }
        .nav-tab-pane { display:none; }
        .nav-tab-pane.active { display:block; }
        .nav-item-row { display:grid; grid-template-columns:160px 1fr; gap:12px; align-items:center; margin-bottom:12px; }
        .nav-item-row label { font-size:.85rem; color:#555; }
    </style>

    <div class="nav-tabs-custom">
        <button class="nav-tab-btn active" onclick="switchNav('vi',this)">🇻🇳 Tiếng Việt</button>
        <button class="nav-tab-btn"        onclick="switchNav('ja',this)">🇯🇵 日本語</button>
        <button class="nav-tab-btn"        onclick="switchNav('en',this)">🇬🇧 English</button>
    </div>

    @foreach (var (lang, defaultVi, defaultJa, defaultEn) in new[] {
        ("vi", "", "", ""), ("ja", "", "", ""), ("en", "", "", "")
    })
    {
        <div class="nav-tab-pane @(lang == "vi" ? "active" : "")" id="nav-pane-@lang">
            <form asp-controller="NavAdmin" asp-action="SaveLang" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lang" value="@lang">

                @foreach (var (key, labelVi, labelJa, labelEn) in items)
                {
                    var label = lang == "ja" ? labelJa : (lang == "en" ? labelEn : labelVi);
                    <div class="nav-item-row">
                        <label>@label</label>
                        <input type="text" name="@key" class="form-control" value="@T(lang, key)">
                    </div>
                }

                <button type="submit" class="btn btn-primary" style="margin-top:8px;">
                    Lưu menu @(lang == "vi" ? "Tiếng Việt" : lang == "ja" ? "日本語" : "English")
                </button>
            </form>
        </div>
    }
</div>

@section Scripts {
<script>
function switchNav(lang, btn) {
    document.querySelectorAll('.nav-tab-pane').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('nav-pane-' + lang).classList.add('active');
    btn.classList.add('active');
}
</script>
}
