@model NewsArticle
@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
    Layout = "_AdminLayout";
    var categories = ViewData["Categories"] as List<NewsCategory> ?? [];
}

@section HeadExtra {
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.css">
}

<h1>Chỉnh sửa bài viết</h1>
<a href="/admin/news" class="btn btn-secondary btn-sm" style="margin-bottom:16px;">← Quay lại danh sách</a>

<div class="admin-card">
    <form asp-controller="NewsAdmin" asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden">
        <input asp-for="CreatedAt" type="hidden">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="form-group" style="grid-column:1/-1;">
                <label>Tiêu đề (Tiếng Nhật)</label>
                <input asp-for="TitleJa" class="form-control" required>
            </div>
            <div class="form-group" style="grid-column:1/-1;">
                <label>Tiêu đề (Tiếng Anh)</label>
                <input asp-for="TitleEn" class="form-control">
            </div>
            <div class="form-group" style="grid-column:1/-1;">
                <label>Tiêu đề (Tiếng Việt)</label>
                <input asp-for="TitleVi" class="form-control">
            </div>
            <div class="form-group">
                <label>Danh mục</label>
                <select asp-for="CategoryId" class="form-control">
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId ? "selected" : null)">@cat.NameJa</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Ngày đăng</label>
                <input asp-for="PublishedAt" type="date" class="form-control">
            </div>
            <div class="form-group">
                <label>Hiển thị</label><br>
                <input asp-for="IsPublished" type="checkbox"> Đăng công khai
            </div>
        </div>
        <div class="form-group">
            <label>Nội dung (Tiếng Nhật)</label>
            <textarea asp-for="BodyJa" class="form-control" rows="8"></textarea>
        </div>
        <div class="form-group">
            <label>Nội dung (Tiếng Anh)</label>
            <textarea asp-for="BodyEn" class="form-control" rows="8"></textarea>
        </div>
        <div class="form-group">
            <label>Nội dung (Tiếng Việt)</label>
            <textarea asp-for="BodyVi" class="form-control" rows="8"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Lưu</button>
    </form>
</div>

@section Scripts {
<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
<script>
['BodyJa', 'BodyEn', 'BodyVi'].forEach(function(id) {
    ClassicEditor.create(document.getElementById(id), {
        simpleUpload: { uploadUrl: '/admin/upload/image' }
    }).catch(console.error);
});
</script>
}
